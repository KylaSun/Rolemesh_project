{
  "openapi": "3.1.0",
  "info": {
    "title": "RoleMesh Backend",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/demo/profile": {
      "get": {
        "tags": [
          "本地演示"
        ],
        "summary": "Get Demo Profile",
        "operationId": "get_demo_profile_demo_profile_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/demo/profile/hours": {
      "patch": {
        "tags": [
          "本地演示"
        ],
        "summary": "Update Demo Hours",
        "operationId": "update_demo_hours_demo_profile_hours_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoHoursUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/demo/matches": {
      "get": {
        "tags": [
          "本地演示"
        ],
        "summary": "数据库虚构画像与数据库岗位匹配",
        "description": "仅供本机演示，固定读取 profile.demo.1。岗位读取数据库中标记为演示的项目，样例由 seed_projects.py 导入。无正式登录，不可作为真实用户画像接口部署。每次请求重新计算，不缓存旧版本结果。",
        "operationId": "get_demo_matches_demo_matches_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/demo/projects": {
      "get": {
        "tags": [
          "本地演示"
        ],
        "summary": "查看数据库中的虚构项目列表",
        "operationId": "demo_project_list_demo_projects_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/demo/projects/{project_id}": {
      "get": {
        "tags": [
          "本地演示"
        ],
        "summary": "查看虚构项目及其岗位要求",
        "operationId": "demo_project_detail_demo_projects__project_id__get",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Project Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DemoHoursUpdate": {
        "properties": {
          "availability_hours_per_week": {
            "type": "number",
            "maximum": 168.0,
            "minimum": 0.0,
            "title": "Availability Hours Per Week"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "availability_hours_per_week"
        ],
        "title": "DemoHoursUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
